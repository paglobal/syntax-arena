      "updated": 1759620705364,
      "link": null,
      "locked": false,
      "text": "Controls\n\n- Press h/left to exit shard\n- Press l/right to enter shard\n- Press j/down to focus next sibling\n- Press k/up to focus previous sibling\n- Press i to add \n- Press a to add shard in front and focus on it\n- Press i to add shard behind and focus on it\n- Press d to delete shard\n- Press b to toggle shard between block and inline\n- Press t to toggle shard type\n- Press enter to accept new input value for shard\n- Press esc to discard new input value for shard\n-Press e execute current statements\n- Press space to pause/play game",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "WiaNhd9OPnKH2sW-Vd0zB",
      "originalText": "Controls\n\n- Press h/left to exit shard\n- Press l/right to enter shard\n- Press j/down to focus next sibling\n- Press k/up to focus previous sibling\n- Press i to add \n- Press a to add shard in front and focus on it\n- Press i to add shard behind and focus on it\n- Press d to delete shard\n- Press b to toggle shard between block and inline\n- Press t to toggle shard type\n- Press enter to accept new input value for shard\n- Press esc to discard new input value for shard\n-Press e execute current statements\n- Press space to pause/play game",
      "autoResize": true,
      "lineHeight": 1.25
    },
