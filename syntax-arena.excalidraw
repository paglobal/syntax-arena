    {
      "id": "obru03ekLxMlS934xrrjk",
      "type": "text",
      "x": 1959.76025390625,
      "y": -1872.5,
      "width": 520.4794921875,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
