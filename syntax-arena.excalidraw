      "seed": 1587088347,
      "version": 2227,
      "versionNonce": 1050383585,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1759620705364,
      "link": null,
      "locked": false,
      "text": "Side notes and advice from YouTube\n\n- Don't forget to compete in the one shot challenge!\n- Only worry about mechanics to begin with\n- Use shapes for the graphics\n- Use free sound clips for the sounds\n- If it's a good proof of concept, add onto it, if it's\nnot fun with it's most base fundamentals, it probably\nwon't be fun when it's all fleshed out either\n- Stick to schedule!\n- Avoid shifting deadline with unnecessary features!\n- Don't be a perfectionist too soon!\n- Remember, there are other features to work on!\n- Don't be afraid to get help where possible!\n- Keep in mind that you have other things to do!\n- God is with you!\n- All the best!",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "aAgrgSzQGCgVA3T1Krd5v",
      "originalText": "Side notes and advice from YouTube\n\n- Don't forget to compete in the one shot challenge!\n- Only worry about mechanics to begin with\n- Use shapes for the graphics\n- Use free sound clips for the sounds\n- If it's a good proof of concept, add onto it, if it's not fun with it's most base fundamentals, it probably won't be fun when it's all fleshed out either\n- Stick to schedule!\n- Avoid shifting deadline with unnecessary features!\n- Don't be a perfectionist too soon!\n- Remember, there are other features to work on!\n- Don't be afraid to get help where possible!\n- Keep in mind that you have other things to do!\n- God is with you!\n- All the best!",
      "autoResize": true,
      "lineHeight": 1.25
    },
